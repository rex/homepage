---
// One page per postmortem in src/content/postmortems/. Drafts build only
// under `astro dev`; in a production build they have no route and 404.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPostmortems, formatMonth, isVisible, type Postmortem } from '../../lib/postmortems';

export async function getStaticPaths() {
  const entries = (await allPostmortems()).filter(isVisible);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Postmortem;
}

const { entry } = Astro.props;
const { title, summary, month, duration, impact, tags, draft } = entry.data;
const { Content } = await render(entry);
---
<BaseLayout title={`${title} — Pierce Moore`} description={summary}>
  <article class="page-gutter pt-32 pb-24 max-w-prose">
    <div class="label-mono mb-3">/ postmortem{draft ? ' · draft' : ''}</div>
    <h1 class="display-roman text-3xl text-ink leading-tight">{title}</h1>
    <p class="mt-4 display-italic text-ink-muted">{summary}</p>
    <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 font-mono text-xs text-ink-dim">
      <dt class="uppercase tracking-[0.16em]">when</dt><dd>{formatMonth(month)}</dd>
      <dt class="uppercase tracking-[0.16em]">duration</dt><dd>{duration}</dd>
      <dt class="uppercase tracking-[0.16em]">impact</dt><dd>{impact}</dd>
      {tags.length > 0 && (
        <><dt class="uppercase tracking-[0.16em]">tags</dt><dd>{tags.join(' · ')}</dd></>
      )}
    </dl>
    <div class="postmortem-body mt-12">
      <Content />
    </div>
    <div class="mt-16">
      <a href="/writing" class="font-mono text-xs uppercase tracking-[0.16em] text-accent border border-[color:var(--accent-dim)] px-4 py-2 hover:border-[color:var(--accent)]">← all writing</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .postmortem-body { color: var(--ink-muted); line-height: 1.7; }
  .postmortem-body > * + * { margin-top: 1.1rem; }
  .postmortem-body h2 {
    margin-top: 2.75rem;
    color: var(--ink);
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .postmortem-body h3 { margin-top: 2rem; color: var(--ink); font-weight: 600; }
  .postmortem-body strong { color: var(--ink); font-weight: 600; }
  .postmortem-body ul, .postmortem-body ol { padding-left: 1.25rem; }
  .postmortem-body ul { list-style: disc; }
  .postmortem-body ol { list-style: decimal; }
  .postmortem-body li + li { margin-top: 0.4rem; }
  .postmortem-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .postmortem-body code { font-family: 'Cascadia Code', monospace; font-size: 0.875em; color: var(--ink); }
  .postmortem-body blockquote {
    border-left: 2px solid var(--accent-dim);
    padding-left: 1rem;
    font-style: italic;
  }
  .postmortem-body table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .postmortem-body th, .postmortem-body td {
    border-bottom: 1px solid var(--accent-dim);
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
    vertical-align: top;
  }
  .postmortem-body th { color: var(--ink); font-family: 'Cascadia Code', monospace; font-size: 0.75rem; }
  .postmortem-body td:first-child { font-family: 'Cascadia Code', monospace; white-space: nowrap; color: var(--ink-dim); }
</style>
