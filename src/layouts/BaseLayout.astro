---
import '../styles/fonts.css';
import '../styles/globals.css';
import '../styles/boot.css';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
// Header is intentionally NOT imported — file retained per spec but the bar is disabled.
// import Header from '../components/Header.astro';
import SkipToContent from '../components/SkipToContent.astro';
import { BUILD_COMMIT, BUILD_DATE } from '../lib/build-info';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  jsonLd,
  bodyClass = '',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://piercemoore.com').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://piercemoore.com').toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="build-commit" content={BUILD_COMMIT} />
    <meta name="build-date" content={BUILD_DATE} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0d10" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="piercemoore.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/Fraunces.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Fraunces-Italic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Supreme-Regular.woff2" crossorigin />

    <script is:inline>
      (function () {
        // Theme precedence:
        //   1. Explicit user toggle (localStorage.theme) wins.
        //   2. Otherwise: system says light → light. Anything else
        //      (system says dark, no preference, API absent) → dark.
        function preferredTheme() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'dark' || stored === 'light') return stored;
          } catch (e) {}
          try {
            if (window.matchMedia('(prefers-color-scheme: light)').matches) return 'light';
          } catch (e) {}
          return 'dark';
        }
        document.documentElement.setAttribute('data-theme', preferredTheme());

        // Reactively follow OS theme changes — only when the user has
        // not made an explicit choice. Once they toggle the page's
        // [dark]/[light] control, localStorage takes over and we stop
        // tracking the OS.
        try {
          var mq = window.matchMedia('(prefers-color-scheme: light)');
          var listener = function (e) {
            try {
              if (localStorage.getItem('theme')) return;
            } catch (err) {}
            document.documentElement.setAttribute('data-theme', e.matches ? 'light' : 'dark');
          };
          if (mq.addEventListener) mq.addEventListener('change', listener);
          else if (mq.addListener) mq.addListener(listener);
        } catch (e) {}

        try {
          if (sessionStorage.getItem('boot-played') === 'true') {
            document.documentElement.classList.add('skip-boot');
          } else {
            setTimeout(function () {
              try {
                sessionStorage.setItem('boot-played', 'true');
              } catch (e) {}
            }, 1500);
          }
        } catch (e) {
          document.documentElement.classList.add('skip-boot');
        }
      })();
    </script>

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass}>
    <SkipToContent />
    <ThemeToggle client:load />
    {/* Header.astro retained but disabled. */}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Console easter egg — fires once per session for the curious.
      (function () {
        try {
          if (sessionStorage.getItem('console-egg-played') === 'true') return;
          sessionStorage.setItem('console-egg-played', 'true');
        } catch (e) {}
        var amber = 'color: #ffb000; font-family: Cascadia Code, monospace;';
        var dim = 'color: #8d877f; font-family: Cascadia Code, monospace;';
        var ink = 'color: #f2ede4; font-family: Cascadia Code, monospace; font-weight: 600;';
        console.log(
          '\n' +
            '%c       /\\_/\\\n' +
            '%c      ( %cλ.λ%c )\n' +
            '%c       ) λ (\n' +
            '%c                                              \n' +
            '%cpiercemoore.com %c- hand-built, opinionated, slow web.\n' +
            '%cstart where you are.\n\n' +
            '%csource:  %chttps://github.com/rex/homepage\n' +
            '%ccto:     %clinus, b. 2014\n',
          ink, ink, amber, ink,
          ink,
          ink,
          ink, dim,
          ink,
          dim, ink,
          dim, ink
        );
      })();
    </script>

    <script is:inline>
      // First-party behavior beacon. Fires GET requests to a long-named
      // endpoint that returns 204; CloudFront access logs capture the
      // query string, which is the entire payload. No cookies, no
      // fingerprinting, no third-party data egress, no CSRF surface.
      // Path is deliberately self-documenting and ad-blocker-friendly
      // (no "track", "analytics", "_p", etc.).
      (function () {
        try {
          var EP = '/this-is-only-here-to-see-real-people-vs-robots-i-am-not-logging-all-your-shit-i-promise';
          function send(params) {
            try {
              var qs = Object.keys(params)
                .filter(function (k) { return params[k] !== undefined && params[k] !== null && params[k] !== ''; })
                .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
                .join('&');
              var url = qs ? EP + '?' + qs : EP;
              if (typeof navigator.sendBeacon === 'function' && navigator.sendBeacon(url)) {
                return;
              }
              fetch(url, { method: 'GET', cache: 'no-store', keepalive: true }).catch(function () {});
            } catch (e) { /* silent */ }
          }

          // 1. Page view on load.
          var refHost = '';
          try { refHost = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
          send({ evt: 'view', p: location.pathname, ref: refHost });

          // 2. Click + outbound + download tracking via one delegated listener.
          document.addEventListener('click', function (e) {
            var path = e.composedPath ? e.composedPath() : [];
            var labelSent = false;
            var anchor = null;
            for (var i = 0; i < path.length; i++) {
              var el = path[i];
              if (!el || !el.getAttribute) continue;
              if (!labelSent) {
                var label = el.getAttribute('data-track');
                if (label) {
                  send({ evt: 'click', p: location.pathname, t: label });
                  labelSent = true;
                }
              }
              if (!anchor && el.tagName === 'A' && el.getAttribute('href')) {
                anchor = el;
              }
            }
            if (anchor) {
              var href = anchor.getAttribute('href') || '';
              if (anchor.host && anchor.host !== location.host) {
                send({ evt: 'outbound', p: location.pathname, u: anchor.host + (anchor.pathname || '') });
              }
              if (href === '/resume.pdf') {
                send({ evt: 'download', p: location.pathname, t: 'resume.pdf' });
              }
            }
          }, true);

          // 3. Section views via IntersectionObserver. Each <section id="..."> reports once.
          if ('IntersectionObserver' in window) {
            var seen = {};
            var io = new IntersectionObserver(function (entries) {
              for (var i = 0; i < entries.length; i++) {
                var entry = entries[i];
                if (entry.isIntersecting && entry.target.id && !seen[entry.target.id]) {
                  seen[entry.target.id] = true;
                  send({ evt: 'section', p: location.pathname, s: entry.target.id });
                }
              }
            }, { threshold: 0.5 });
            var sections = document.querySelectorAll('section[id]');
            for (var i = 0; i < sections.length; i++) {
              io.observe(sections[i]);
            }
          }

          // 4. Theme toggle via MutationObserver on <html data-theme>.
          if (typeof MutationObserver === 'function') {
            var lastTheme = document.documentElement.getAttribute('data-theme') || '';
            var mo = new MutationObserver(function () {
              var t = document.documentElement.getAttribute('data-theme') || '';
              if (t && t !== lastTheme) {
                send({ evt: 'theme', v: t });
                lastTheme = t;
              }
            });
            mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
          }
        } catch (e) { /* silent */ }
      })();
    </script>
  </body>
</html>
