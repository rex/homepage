# piercemoore.com infrastructure -- env vars consumed at CDK synth time.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# at the repo root and must NEVER be committed. The Makefile sources it
# automatically before invoking `cdk`.

# ---------------------------------------------------------------------
# Admin gate for /admin/* (HTTP Basic Auth on the CloudFront Function).
# Pick ONE of the two options below. If both are set, _AUTH wins.
# ---------------------------------------------------------------------

# Option A -- full Authorization header value, pre-encoded.
# Compute with:
#   printf '%s' 'pierce:your-real-password' | base64
# Then paste the result after "Basic " (the space is required):
#
# PIERCEMOORE_ADMIN_AUTH='Basic cGllcmNlOnlvdXItcmVhbC1wYXNzd29yZA=='

# Option B -- split user + password. The synth step base64-encodes
# user:pass and prefixes "Basic " for you.
PIERCEMOORE_ADMIN_USER='pierce'
PIERCEMOORE_ADMIN_PASS='change-me-to-something-long-and-random'

# ---------------------------------------------------------------------
# AWS credentials are NOT read from this file. Use your usual AWS_PROFILE
# / aws sso login / role-chained shell. The Makefile inherits whatever
# AWS_* vars are in your shell when you run `make deploy`.
# ---------------------------------------------------------------------
