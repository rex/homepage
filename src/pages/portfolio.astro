---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPortfolio } from '../lib/portfolio-content';
import '../styles/portfolio.css';

const portfolio = await loadPortfolio();
const featured = portfolio.projects.filter((project) => project.featured);
const selected = portfolio.projects.find((project) => project.selected) ?? portfolio.projects[0];

if (!selected) {
  throw new Error('Portfolio content requires at least one project.');
}

const projectGroups = portfolio.groups.map((group) => ({
  ...group,
  projects: portfolio.projects.filter((project) => project.group === group.label),
}));
const typeLabels = new Map(portfolio.types.map((type) => [type.id, type.label]));
const stateLabels = new Map(portfolio.states.map((state) => [state.id, state.label]));
const typeCount = (type: string) => portfolio.projects.filter((project) => project.type === type).length;
---

<BaseLayout title={portfolio.title} description={portfolio.description} bodyClass="portfolio-page">
  <div class="portfolio-shell">
    <header class="portfolio-masthead">
      <p class="portfolio-breadcrumb"><span>{portfolio.nav.site}</span><b>/</b><span>{portfolio.nav.route}</span></p>
      <p class="portfolio-availability"><i></i>{portfolio.nav.availability}</p>
    </header>

    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <p class="portfolio-margin">{portfolio.index.issue}</p>
      <div class="portfolio-intro">
        <h1 id="portfolio-title">{portfolio.index.title}</h1>
        <div class="portfolio-count">
          <strong>{portfolio.projects.length}</strong>
          <span>{portfolio.index.total_label}</span>
          <p>{portfolio.index.summary}</p>
        </div>
      </div>

      <div class="portfolio-featured">
        <p class="portfolio-kicker">{portfolio.labels.flagship}</p>
        <div class="portfolio-featured-grid">
          {featured.map((project) => (
            <article class="portfolio-feature">
              <p><span>{project.id}</span><span>/ {typeLabels.get(project.type)}</span></p>
              <div class="portfolio-preview" data-preview={project.preview} aria-hidden="true">
                <div class="preview-top"><i></i><i></i><i></i></div>
                <div class="preview-side"><i></i><i></i><i></i><i></i></div>
                <div class="preview-body"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
              <h2>{project.title}</h2>
              <small>{project.subtitle}</small>
            </article>
          ))}
        </div>
        <a class="portfolio-all-flagship" href="#inventory">{portfolio.labels.all_flagship}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="portfolio-filters" aria-label={portfolio.labels.view}>
      <div class="portfolio-filter portfolio-filter--jump">
        <p>{portfolio.labels.jump}</p>
        <nav aria-label={portfolio.labels.jump}>
          {projectGroups.map((group) => <a href={`#group-${group.letters}`}>{group.label}</a>)}
        </nav>
      </div>
      <div class="portfolio-filter"><p>{portfolio.labels.type}</p><span>{portfolio.filters.types.join(' · ')}</span></div>
      <div class="portfolio-filter"><p>{portfolio.labels.depth}</p><span>{portfolio.filters.depths.join(' · ')}</span></div>
      <div class="portfolio-filter"><p>{portfolio.labels.view}</p><span>{portfolio.filters.views.join(' · ')}</span></div>
    </section>

    <section class="portfolio-index" id="inventory" aria-label={portfolio.labels.all}>
      <aside class="portfolio-aside">
        <ul class="portfolio-legend" aria-label={portfolio.labels.view}>
          {portfolio.states.map((state) => <li><i data-state={state.id}></i>{state.label}</li>)}
        </ul>
        <div class="portfolio-type-count">
          <p>{portfolio.labels.count_by_type}</p>
          <ul>{portfolio.types.map((type) => <li><span>{type.label}</span><b>{String(typeCount(type.id)).padStart(2, '0')}</b></li>)}</ul>
        </div>
      </aside>

      <div class="portfolio-directory">
        {projectGroups.map((group) => (
          <section class="portfolio-letter-group" id={`group-${group.letters}`}>
            <h2>{group.label}</h2>
            <ul>
              {group.projects.map((project) => (
                <li class:list={['portfolio-project', { 'portfolio-project--selected': project.selected }]}>
                  <span class="portfolio-project-name">{project.title}</span>
                  <span class="portfolio-project-meta"><i data-preview={project.preview} aria-hidden="true"></i><b>{project.id}</b><em data-state={project.state} aria-hidden="true"></em><span class="sr-only">{stateLabels.get(project.state)}</span></span>
                </li>
              ))}
            </ul>
            <p>{group.projects.length} {portfolio.index.total_label}</p>
          </section>
        ))}
      </div>

      <aside class="portfolio-selected" id="selected">
        <p class="portfolio-kicker">{portfolio.labels.selected}</p>
        <p class="portfolio-selected-id">{selected.id} / {typeLabels.get(selected.type)}</p>
        <h2>{selected.title}</h2>
        <p class="portfolio-selected-subtitle">{selected.subtitle}</p>
        <div class="portfolio-selected-preview" data-preview={selected.preview} aria-hidden="true">
          <div class="selected-panel"></div>
          <svg viewBox="0 0 480 250" focusable="false"><path d="M35 38H130V95H220V145H330V210H444"/><path d="M62 208V134H170V64H265V110H410"/><circle cx="130" cy="38" r="4"/><circle cx="220" cy="95" r="4"/><circle cx="330" cy="145" r="4"/><circle cx="170" cy="134" r="4"/><circle cx="265" cy="64" r="4"/></svg>
        </div>
        <dl>
          <div><dt>{portfolio.labels.thesis}</dt><dd>{selected.thesis}</dd></div>
          <div><dt>{portfolio.labels.stack}</dt><dd>{selected.stack}</dd></div>
          <div><dt>{portfolio.labels.artifacts}</dt><dd><ul>{selected.artifacts?.map((artifact) => <li><b>{artifact.index}</b>{artifact.label}<span aria-hidden="true">→</span></li>)}</ul></dd></div>
        </dl>
      </aside>
    </section>

    <footer class="portfolio-terminal"><span aria-hidden="true">λ</span><p>{portfolio.labels.terminal}</p><small>{portfolio.labels.source} · {stateLabels.get(selected.state)}</small></footer>
  </div>
</BaseLayout>
